---
import "../styles/global.css";
import Stars from "../components/Stars.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mario — Portfolio",
  description = "Full-stack developer & designer. Building digital experiences.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="noise-overlay">
    <!-- Starfield renders below everything -->
    <Stars />
    <!-- Content sits above stars -->
    <div class="relative" style="z-index: 1;">
      <slot />
    </div>
    <!-- Script 1: scroll reveal — siempre corre, no depende de Lenis -->
    <script>
      const revealEls = document.querySelectorAll('.reveal');

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in-view');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.04, rootMargin: '0px 0px -20px 0px' }
      );
      revealEls.forEach((el) => observer.observe(el));

      // Fallback garantizado: muestra todo a 1s
      setTimeout(() => {
        revealEls.forEach((el) => el.classList.add('in-view'));
      }, 1000);
    </script>

    <!-- Script 2: Lenis smooth scroll — opcional, no bloquea nada -->
    <script>
      import Lenis from 'lenis';

      try {
        const lenis = new Lenis({ lerp: 0.07, smoothWheel: true, touchMultiplier: 1.4 });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', (e) => {
            const id = (anchor as HTMLAnchorElement).getAttribute('href')!;
            if (!id || id === '#') return;
            e.preventDefault();
            try {
              const target = document.querySelector(id);
              if (target) lenis.scrollTo(target as HTMLElement, { offset: -80, duration: 1.4 });
            } catch {}
          });
        });
      } catch (err) {
        console.warn('Lenis init failed, using native scroll', err);
      }
    </script>

    <!-- Script 3: navbar scroll + mobile menu -->
    <script>
      const navbar  = document.getElementById('navbar');
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          navbar?.classList.add('bg-obsidian/90', 'backdrop-blur-md', 'border-b', 'border-surface');
        } else {
          navbar?.classList.remove('bg-obsidian/90', 'backdrop-blur-md', 'border-b', 'border-surface');
        }
      });

      menuBtn?.addEventListener('click', () => mobileMenu?.classList.toggle('hidden'));
      mobileMenu?.querySelectorAll('a').forEach((link) =>
        link.addEventListener('click', () => mobileMenu.classList.add('hidden'))
      );
    </script>
  </body>
</html>
