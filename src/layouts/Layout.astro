---
import "../styles/global.css";
import { CONTACT, META } from "../data/content";
import { PERSON } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  /** OpenGraph type: "profile" for the home page, "article" for case studies. */
  ogType?: "profile" | "article" | "website";
  /** JSON-LD for this page; defaults to the Person profile. */
  structuredData?: Record<string, unknown>;
}

// Pages are server-rendered in English; the React app (useLang) switches <html lang>,
// the description and og:locale on the client when Spanish is active.
const { title = META.title, description = META.description.en, ogType = "profile", structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? CONTACT.site).href;

const jsonLd = structuredData ?? {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: canonical,
  mainEntity: PERSON,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mario Yael Gordillo García" />
    <meta name="theme-color" content="#030014" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="MAEL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_MX" />
    {
      ogType === "profile" && (
        <>
          <meta property="profile:first_name" content="Mario Yael" />
          <meta property="profile:last_name" content="Gordillo García" />
        </>
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <slot />

    <script>
      import Lenis from 'lenis';

      // Lenis smooth scroll is an optional enhancement: skipped entirely for
      // visitors who prefer reduced motion, and native scroll keeps working
      // if it fails to start.
      let reduce = false;
      try {
        reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch {
        /* matchMedia unavailable */
      }

      let lenis: Lenis | null = null;
      if (!reduce) {
        try {
          lenis = new Lenis({ lerp: 0.1, smoothWheel: true, touchMultiplier: 1.4 });
          // After Lenis moves the page, tell anything drawn against scroll (the
          // sky) to paint this same frame, so it never lags a frame behind.
          const raf = (time: number) => {
            lenis!.raf(time);
            window.dispatchEvent(new CustomEvent('mael:frame', { detail: time }));
            requestAnimationFrame(raf);
          };
          requestAnimationFrame(raf);
        } catch (err) {
          console.warn('Lenis init failed, using native scroll', err);
          lenis = null;
        }
      }

      // In-page links, delegated so links rendered later by React (mobile
      // menu, language switch re-renders) are covered too. After scrolling,
      // focus moves to the target so keyboard and screen-reader users
      // continue from the section they jumped to.
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const anchor = (e.target as Element | null)?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
        if (!anchor) return;
        const hash = anchor.getAttribute('href') ?? '';
        const target = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
        if (!target) return;
        e.preventDefault();

        // Land below the fixed top bar.
        const header = document.getElementById('site-nav');
        const offset = header ? -(header.getBoundingClientRect().bottom + 12) : 0;
        if (lenis) {
          lenis.scrollTo(target, { offset, duration: 1.1 });
        } else {
          const top = target.getBoundingClientRect().top + window.scrollY + offset;
          window.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
        }

        if (history.replaceState) history.replaceState(null, '', hash);
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
