---
import "../styles/global.css";
import Stars from "../components/Stars.astro";
import CosmicBackdrop from "../components/CosmicBackdrop.astro";
import { CONTACT, META } from "../data/content";

interface Props {
  title?: string;
  description?: string;
  /** Home page only: the brief "MYG / SYSTEM INITIALIZING" intro. */
  intro?: boolean;
}

// Pages are server-rendered in English; the React app (useLang) switches <html lang>,
// the description and og:locale on the client when Spanish is active.
const { title = META.title, description = META.description.en, intro = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? CONTACT.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: canonical,
  mainEntity: {
    "@type": "Person",
    name: "Mario Yael Gordillo García",
    alternateName: "MAEL",
    jobTitle: "Software Developer",
    url: CONTACT.site,
    email: `mailto:${CONTACT.email}`,
    sameAs: [CONTACT.github],
    affiliation: { "@type": "CollegeOrUniversity", name: "UPIICSA — Instituto Politécnico Nacional" },
    knowsAbout: ["Software Engineering", "Full Stack Development", "Backend Development", "System Integration", "Business Process Analysis", "Software Architecture", "Java", "Quarkus", "Python", "TypeScript", "Angular", "React", "PostgreSQL"],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mario Yael Gordillo García" />
    <meta name="theme-color" content="#030014" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="MAEL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_MX" />
    <meta property="profile:first_name" content="Mario Yael" />
    <meta property="profile:last_name" content="Gordillo García" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      intro && (
        <script is:inline>
          // Decide before first paint whether the intro plays: once per session,
          // never under reduced motion. Without JS the overlay never shows.
          (function () {
            var d = document.documentElement;
            try {
              var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
              var seen = sessionStorage.getItem("mael.intro") === "1";
              d.dataset.intro = reduce || seen ? "skip" : "play";
              if (!reduce) sessionStorage.setItem("mael.intro", "1");
            } catch (e) {
              d.dataset.intro = "skip";
            }
          })();
        </script>
      )
    }
  </head>
  <body class="bg-bg text-ink">
    <!-- Starfield renders below everything -->
    <Stars />
    <!-- Grid/noise/glow texture layer, above the starfield -->
    <CosmicBackdrop />
    {
      intro && (
        <div class="intro" aria-hidden="true">
          <span class="intro__text">MYG / SYSTEM INITIALIZING</span>
          <span class="intro__bar" />
        </div>
      )
    }
    <!-- Content sits above the background -->
    <div class="relative" style="z-index: 1;">
      <slot />
    </div>

    <script>
      import Lenis from 'lenis';

      // Lenis smooth scroll is an optional enhancement: skipped entirely for
      // visitors who prefer reduced motion, and native scroll keeps working
      // if it fails to start.
      let reduce = false;
      try {
        reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch {
        /* matchMedia unavailable */
      }

      let lenis: Lenis | null = null;
      if (!reduce) {
        try {
          lenis = new Lenis({ lerp: 0.1, smoothWheel: true, touchMultiplier: 1.4 });
          const raf = (time: number) => {
            lenis!.raf(time);
            requestAnimationFrame(raf);
          };
          requestAnimationFrame(raf);
        } catch (err) {
          console.warn('Lenis init failed, using native scroll', err);
          lenis = null;
        }
      }

      // In-page links, delegated so links rendered later by React (mobile
      // menu, language switch re-renders) are covered too. After scrolling,
      // focus moves to the target so keyboard and screen-reader users
      // continue from the section they jumped to.
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const anchor = (e.target as Element | null)?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
        if (!anchor) return;
        const hash = anchor.getAttribute('href') ?? '';
        const target = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
        if (!target) return;
        e.preventDefault();

        const header = document.getElementById('site-nav');
        const offset = -((header?.getBoundingClientRect().height ?? 64) + 12);
        if (lenis) {
          lenis.scrollTo(target, { offset, duration: 1.1 });
        } else {
          const top = target.getBoundingClientRect().top + window.scrollY + offset;
          window.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
        }

        if (history.replaceState) history.replaceState(null, '', hash);
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
