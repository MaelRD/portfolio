---
import "../styles/global.css";
import Stars from "../components/Stars.astro";
import CosmicBackdrop from "../components/CosmicBackdrop.astro";
import Boot from "../components/Boot.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mario Yael Gordillo — Software Engineer",
  description = "Software engineer building backend systems, business apps and ERP integrations with Java, Quarkus, Angular and Odoo.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="bg-bg text-ink">
    <!-- Starfield renders below everything -->
    <Stars />
    <!-- Grid/noise/glow texture layer, above the starfield -->
    <CosmicBackdrop />
    <!-- Boot splash, shown once per session -->
    <Boot />
    <!-- Content sits above the background -->
    <div class="relative" style="z-index: 1;">
      <slot />
    </div>

    <!-- Lenis smooth scroll, optional enhancement — never blocks native scroll -->
    <script>
      import Lenis from 'lenis';

      try {
        // lerp 0.1 is Lenis's own documented default — the previous 0.07 over-smoothed
        // the wheel/touch response, making scroll feel laggy/disconnected from input
        // (each frame only closes 7% of the remaining distance instead of 10%).
        const lenis = new Lenis({ lerp: 0.1, smoothWheel: true, touchMultiplier: 1.4 });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', (e) => {
            const id = (anchor as HTMLAnchorElement).getAttribute('href')!;
            if (!id || id === '#') return;
            const target = document.querySelector(id);
            if (!target) return;
            e.preventDefault();
            const header = document.getElementById('site-nav');
            const offset = -(header?.getBoundingClientRect().height ?? 60);
            try {
              lenis.scrollTo(target as HTMLElement, { offset, duration: 1.2 });
            } catch {}
          });
        });
      } catch (err) {
        console.warn('Lenis init failed, using native scroll', err);
        // Only reach for CSS smooth-scroll as a fallback when Lenis isn't driving
        // scroll — with Lenis active it already applies `behavior: "instant"` on
        // every frame internally, so leaving `scroll-behavior: smooth` on <html>
        // globally just adds a second, uncoordinated smoothing pass for anything
        // Lenis doesn't intercept (keyboard scroll, scrollIntoView, etc).
        document.documentElement.style.scrollBehavior = 'smooth';
      }
    </script>
  </body>
</html>
