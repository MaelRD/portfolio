---
// One-time boot splash, shown only once per browser session (sessionStorage).
// Implemented outside the React island so it can hide itself before first
// paint on repeat visits, with zero hydration cost.
---

<div id="boot-screen" class="boot-screen" aria-hidden="true">
  <div class="boot-inner">
    <span class="boot-logo">MAEL<span class="text-violet-500">.</span></span>
    <span class="boot-tag">ENGINEERING SYSTEM</span>
    <span class="boot-status"><span class="boot-dot"></span>SYSTEM ONLINE</span>
  </div>
</div>

<style>
  .boot-screen {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: #030014;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    animation: mael-boot-out 1100ms cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }
  .boot-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .boot-logo {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .boot-tag {
    font-family: 'Geist Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.24em;
    color: #94A3B8;
  }
  .boot-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: 'Geist Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.18em;
    color: #38BDF8;
  }
  .boot-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #38BDF8;
    animation: mael-online 3.2s ease-in-out infinite;
  }
</style>

<script>
  (function () {
    const el = document.getElementById('boot-screen');
    if (!el) return;
    try {
      if (window.sessionStorage.getItem('mael.booted') === '1') {
        el.style.display = 'none';
      } else {
        window.sessionStorage.setItem('mael.booted', '1');
      }
    } catch {
      // sessionStorage unavailable (privacy mode) — just let the boot animation play once.
    }
  })();
</script>
