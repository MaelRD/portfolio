---
const links = [
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#stack", label: "Stack" },
  { href: "#experiencia", label: "Experiencia" },
  { href: "#contacto", label: "Contacto" },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-smooth"
>
  <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
    <a
      href="#"
      class="font-headline font-bold text-lg tracking-normal text-offwhite hover:text-cin-red transition-colors duration-300"
    >
      M<span class="text-cin-red">.</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-medium text-muted hover:text-offwhite transition-colors duration-300 relative group"
            >
              {link.label}
              <span class="absolute -bottom-0.5 left-0 w-0 h-px bg-cin-red transition-all duration-300 group-hover:w-full" />
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="#contacto"
      class="hidden md:inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-cin-red border border-cin-red/30 hover:bg-cin-red/10 transition-all duration-200 cursor-pointer"
    >
      Hablemos
    </a>

    <!-- Mobile menu button -->
    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-1"
      aria-label="Abrir menú"
    >
      <span class="w-6 h-px bg-offwhite transition-all duration-300"></span>
      <span class="w-4 h-px bg-cin-red transition-all duration-300"></span>
      <span class="w-6 h-px bg-offwhite transition-all duration-300"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-obsidian/98 backdrop-blur-md border-t border-surface"
  >
    <ul class="flex flex-col px-6 py-5 gap-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-body text-sm font-medium text-muted hover:text-offwhite transition-colors duration-200 block py-2"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

