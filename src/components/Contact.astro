---
const socials = [
  {
    name: 'GitHub',
    href: 'https://github.com/MaelRD',
    icon: `<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>`,
    fill: true,
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/mario-yael-gordillo-garc%C3%ADa-85762a1a9/',
    icon: `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`,
    fill: true,
  },
];
---

<section id="contacto" class="py-24 lg:py-32 bg-surface/30">
  <div class="max-w-6xl mx-auto px-6">

    <div class="grid lg:grid-cols-2 gap-16 items-start">

      <!-- Left: text -->
      <div class="space-y-6">
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-8 h-px bg-cin-red"></div>
            <span class="text-cin-red text-xs font-medium tracking-[0.2em] uppercase">Contacto</span>
          </div>
          <h2 class="font-headline font-bold text-4xl md:text-5xl tracking-tighter text-offwhite">
            Construyamos<br /><span class="text-muted">algo juntos</span>
          </h2>
        </div>

        <p class="text-muted text-sm leading-relaxed max-w-sm">
          Estoy disponible para proyectos freelance, posiciones full-time y colaboraciones interesantes. Si tienes una idea, cuéntame.
        </p>

        <div class="space-y-3">
          <a
            href="mailto:tu@email.com"
            class="group flex items-center gap-3 text-sm text-muted hover:text-offwhite transition-colors duration-300"
          >
            <div class="w-8 h-8 rounded bg-surface flex items-center justify-center group-hover:bg-cin-red/10 transition-colors duration-300">
              <svg class="w-4 h-4 text-cin-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            marioyaelgg@gmail.com
          </a>
        </div>

        <!-- Social links -->
        <div class="flex gap-4 pt-2">
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.name}
              class="w-10 h-10 rounded bg-surface flex items-center justify-center text-muted hover:text-cin-red hover:bg-cin-red/10 transition-all duration-300"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <Fragment set:html={social.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Right: form -->
      <form
        id="contact-form"
        class="space-y-4"
        action="https://formspree.io/f/TU_ID"
        method="POST"
      >
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="name" class="text-xs font-medium text-muted uppercase tracking-wider">Nombre</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Tu nombre"
              class="w-full px-4 py-3 bg-surface border border-surface text-sm text-offwhite placeholder-muted/60 rounded focus:outline-none focus:border-cin-red/50 transition-colors duration-300"
            />
          </div>
          <div class="space-y-1.5">
            <label for="email" class="text-xs font-medium text-muted uppercase tracking-wider">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="tu@email.com"
              class="w-full px-4 py-3 bg-surface border border-surface text-sm text-offwhite placeholder-muted/60 rounded focus:outline-none focus:border-cin-red/50 transition-colors duration-300"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="subject" class="text-xs font-medium text-muted uppercase tracking-wider">Asunto</label>
          <input
            type="text"
            id="subject"
            name="subject"
            placeholder="¿De qué quieres hablar?"
            class="w-full px-4 py-3 bg-surface border border-surface text-sm text-offwhite placeholder-muted/60 rounded focus:outline-none focus:border-cin-red/50 transition-colors duration-300"
          />
        </div>

        <div class="space-y-1.5">
          <label for="message" class="text-xs font-medium text-muted uppercase tracking-wider">Mensaje</label>
          <textarea
            id="message"
            name="message"
            required
            rows={5}
            placeholder="Cuéntame sobre tu proyecto..."
            class="w-full px-4 py-3 bg-surface border border-surface text-sm text-offwhite placeholder-muted/60 rounded focus:outline-none focus:border-cin-red/50 transition-colors duration-300 resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="group w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-cin-red text-white font-medium text-sm rounded hover:bg-deep-red transition-all duration-300 ease-smooth"
        >
          Enviar mensaje
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </button>
      </form>

    </div>
  </div>
</section>

<!-- Footer -->
<footer class="py-8 border-t border-surface">
  <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-xs text-muted">
      © {new Date().getFullYear()} Mario. Construido con
      <a href="https://astro.build" class="text-cin-red hover:text-offwhite transition-colors">Astro</a>
      &amp;
      <a href="https://tailwindcss.com" class="text-cin-red hover:text-offwhite transition-colors">Tailwind</a>.
    </p>
    <a href="#" class="text-xs text-muted hover:text-cin-red transition-colors duration-300 flex items-center gap-1.5">
      Volver arriba
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </a>
  </div>
</footer>
