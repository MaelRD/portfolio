---
const jobs = [
  {
    company: "CPA Group",
    role: "Aux. Soporte Odoo",
    period: "Feb 2026 — Presente",
    description:
      "Soporte técnico, personalización y despliegue de soluciones en el ecosistema Odoo, enfocado en estabilidad y operación en producción.",
    achievements: [
      "Configuración y personalización avanzada de módulos en Odoo.",
      "Desarrollo de integraciones entre microservicios en Java (Quarkus) y Odoo mediante XML-RPC.",
      "Gestión de persistencia de datos con PostgreSQL, asegurando integridad y consistencia.",
      "Resolución de incidencias críticas en producción y mantenimiento de la operación.",
      "Documentación de flujos y capacitación a usuarios finales para adopción del sistema.",
      "Automatización de validaciones y procesos para mejorar la calidad de la información.",
    ],
  },
  {
    company: "CPA Group",
    role: "Becario - Soporte Odoo (ERP)",
    period: "Mar 2025 — Feb 2026",
    description:
      "Soporte funcional y técnico en entorno ERP Odoo, enfocado en operación y atención a usuarios.",
    achievements: [
      "Migración y carga masiva de datos mediante herramientas de Odoo y scripts.",
      "Configuración y personalización de módulos estándar y personalizados.",
      "Resolución de incidencias de usuarios finales.",
      "Documentación de procesos y flujos operativos.",
    ],
  },
  {
    company: "Corporativo Emeth",
    role: "Servicio Social - Desarrollador Backend",
    period: "Jul 2025 — Ene 2026",
    description:
      "Desarrollo de servicios backend en Java, enfocados en escalabilidad, rendimiento y buenas prácticas.",
    achievements: [
      "Diseño e implementación de APIs REST para integración de sistemas.",
      "Optimización de consultas SQL para mejorar tiempos de respuesta.",
      "Automatización de procesos internos.",
      "Documentación técnica de servicios y flujos backend.",
      "Control de versiones con Git para asegurar estabilidad del código.",
    ],
  },
];
---

<section id="experiencia" class="py-24 lg:py-32">
  <div class="max-w-6xl mx-auto px-6">
    <div class="space-y-3 mb-16 reveal">
      <div class="flex items-center gap-3">
        <div class="w-8 h-px bg-cin-red"></div>
        <span class="font-body text-cin-red text-[10px] font-medium tracking-[0.25em] uppercase">Trayectoria</span>
      </div>
      <h2 class="font-headline font-bold text-4xl md:text-5xl tracking-normal text-offwhite">
        Experiencia<br /><span class="text-muted">Profesional</span>
      </h2>
    </div>

    <div class="relative">
      <div class="absolute left-0 md:left-[220px] top-0 bottom-0 w-px bg-surface"></div>

      <div class="space-y-12">
        {
          jobs.map((job, i) => (
            <div class={`group relative grid md:grid-cols-[220px_1fr] gap-8 reveal stagger-${i + 1}`}>
              <div class="md:text-right md:pr-8 space-y-1">
                <p class="font-body text-xs font-mono text-cin-red">{job.period}</p>
                <p class="font-body text-sm font-medium text-muted">{job.company}</p>
              </div>

              <!-- Crystal timeline node -->
              <div class="hidden md:flex absolute left-[220px] top-1 -translate-x-1.5 items-center justify-center w-3 h-3">
                <div class="absolute w-3 h-3 rounded-full bg-cin-red/10 group-hover:bg-cin-red/20 transition-colors duration-300 crystal"></div>
                <div class="w-1.5 h-1.5 rounded-full bg-cin-red/50 group-hover:bg-cin-red transition-colors duration-300 relative z-10"></div>
              </div>

              <div class="pl-0 md:pl-8 space-y-4">
                <h3 class="font-headline font-bold text-xl text-offwhite">{job.role}</h3>
                <p class="font-body text-muted text-sm leading-relaxed">{job.description}</p>
                <ul class="space-y-2">
                  {job.achievements.map((item) => (
                    <li class="flex items-start gap-3 font-body text-sm text-muted">
                      <span class="mt-1.5 w-1 h-1 rounded-full bg-cin-red/50 flex-shrink-0" />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-16 pt-10 border-t border-surface flex flex-col sm:flex-row sm:items-center justify-between gap-4 reveal">
      <div>
        <p class="font-body text-sm font-medium text-offwhite">Ingeniería en Informática</p>
        <p class="font-body text-xs text-muted mt-1">Instituto Politécnico Nacional - UPIICSA</p>
      </div>
      <a
        href="/MARIO_YAEL_CV.pdf"
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-cin-red border border-cin-red/30 hover:bg-cin-red/10 transition-colors duration-200 self-start sm:self-auto cursor-pointer"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"
          ></path>
        </svg>
        Descargar CV Completo
      </a>
    </div>
  </div>
</section>
