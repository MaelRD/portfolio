---
const categories = [
  {
    name: "Backend",
    skills: [
      "Java · Quarkus · Spring",
      "Python · FastAPI · Scripts",
      "PostgreSQL · MySQL",
    ],
  },
  {
    name: "Frontend & Web",
    skills: [
      "HTML · CSS · Tailwind",
      "JavaScript · TypeScript",
      "Astro · React",
    ],
  },
  {
    name: "Infra & DevOps",
    skills: [
      "Docker · Containers",
      "Git · GitHub Workflows",
      "Linux Server Mgmt.",
    ],
  },
];

const tools = [
  { name: "Odoo",        icon: "odoo" },
  { name: "IntelliJ",   icon: "intellijidea" },
  { name: "Docker",     icon: "docker" },
  { name: "Postman",    icon: "postman" },
  { name: "Notion",     icon: "notion" },
  { name: "Linux",      icon: "linux" },
  { name: "GitHub",     icon: "github" },
];
---

<section id="stack" class="py-24 lg:py-32">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Header -->
    <div class="space-y-3 mb-16 reveal">
      <div class="flex items-center gap-3">
        <div class="w-8 h-px bg-cin-red"></div>
        <span class="font-body text-cin-red text-[10px] font-medium tracking-[0.25em] uppercase">Habilidades</span>
      </div>
      <h2 class="font-headline font-bold text-4xl md:text-5xl tracking-normal text-offwhite">
        Stack<br /><span class="text-muted">& Tecnologías</span>
      </h2>
    </div>

    <!-- Editorial skill columns -->
    <div class="grid md:grid-cols-3 gap-10 md:gap-16 mb-16">
      {categories.map((cat, i) => (
        <div class={`reveal stagger-${i + 1}`}>
          <h3 class="font-body text-[10px] font-semibold tracking-[0.25em] text-cin-red uppercase mb-6">{cat.name}</h3>
          <ul class="space-y-3.5">
            {cat.skills.map((skill) => (
              <li class="group flex items-center gap-3">
                <span class="w-1 h-1 rounded-full bg-cin-red/30 group-hover:bg-cin-red transition-colors duration-200 shrink-0"></span>
                <span class="font-body text-sm text-muted group-hover:text-offwhite transition-colors duration-200">{skill}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Crystal tool chips -->
    <div class="border-t border-surface pt-10 reveal stagger-4">
      <p class="font-body text-[10px] text-muted/35 tracking-[0.25em] uppercase mb-6">Herramientas y entornos</p>
      <div class="flex flex-wrap gap-2">
        {tools.map((tool) => (
          <div class="crystal crystal-sweep group flex items-center gap-2.5 px-4 py-2.5 hover:border-cin-red/25 transition-colors duration-200 cursor-pointer">
            <img
              src={`https://cdn.simpleicons.org/${tool.icon}/D84040`}
              alt={tool.name}
              class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity duration-200 relative z-10"
            />
            <span class="font-body text-xs text-muted group-hover:text-offwhite transition-colors duration-200 relative z-10">{tool.name}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
