---
const data = [
  { label: "Ubicación",    value: "Ciudad de México, MX" },
  { label: "Enfoque",      value: "Backend · ERP · APIs" },
  { label: "Estado",       value: "Disponible" },
  { label: "Formación",    value: "Ing. Informática · IPN UPIICSA" },
];

const traits = [
  "Arquitectura de APIs",
  "Sistemas ERP",
  "PostgreSQL",
  "Microservicios",
  "Documentación técnica",
  "Java · Python",
];
---

<section id="sobre-mi" class="py-24 lg:py-32 relative">

  <!-- Ambient glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[40vh] pointer-events-none"
    style="background: radial-gradient(ellipse, rgba(216,64,64,0.04) 0%, transparent 70%); filter: blur(40px);"
    aria-hidden="true"
  ></div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">

    <!-- Header -->
    <div class="mb-20 reveal">
      <div class="flex items-center gap-4 mb-3">
        <div class="w-8 h-px bg-cin-red"></div>
        <span class="font-orbit text-cin-red text-[8px] tracking-[0.4em] uppercase">Personnel File · MYG-01</span>
      </div>
      <h2 class="font-headline font-bold text-4xl md:text-5xl tracking-normal text-offwhite">
        Sobre mí<br /><span class="text-muted">& mi misión</span>
      </h2>
    </div>

    <!-- Main grid -->
    <div class="grid lg:grid-cols-[1fr_380px] gap-16 items-start">

      <!-- Left: Bio -->
      <div class="space-y-10 reveal stagger-1">

        <!-- Classification bar -->
        <div class="flex items-center gap-4 font-orbit text-[7px] tracking-[0.4em] text-muted/30 uppercase">
          <span>COORD: 19.43° N · 99.13° W</span>
          <div class="flex-1 h-px bg-surface"></div>
          <span>CLEARANCE · FULL</span>
        </div>

        <!-- Bio paragraphs -->
        <div class="space-y-5 max-w-[58ch]">
          <p class="font-body text-muted text-[0.9375rem] leading-[1.95]">
  Soy desarrollador fullstack con enfoque en backend, especializado en la construcción de sistemas robustos y escalables.
  Trabajo con <span class="text-offwhite/90">Java, Python y PostgreSQL</span>, con experiencia en entornos ERP y APIs REST en producción.
</p>
<p class="font-body text-muted text-[0.9375rem] leading-[1.95]">
  Desarrollo software pensado para escalar: limpio, mantenible y con arquitectura sólida. Cada solución está diseñada para evolucionar con el tiempo, no solo para cumplir una función inmediata.
</p>
        </div>

        <!-- Traits / competencias -->
        <div class="space-y-3 reveal stagger-2">
          <span class="font-orbit text-[7px] text-muted/30 tracking-[0.35em] uppercase">Competencias clave</span>
          <div class="flex flex-wrap gap-2 mt-3">
            {traits.map((t) => (
              <span class="font-body text-xs text-muted/70 border border-surface/60 px-3 py-1.5 hover:border-cin-red/30 hover:text-offwhite/80 transition-colors duration-200 cursor-default">
                {t}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Data dossier card -->
      <div class="crystal space-y-0 reveal stagger-3">

        <!-- Card header -->
        <div class="px-6 pt-6 pb-4 border-b border-white/5">
          <span class="font-orbit text-[7px] text-cin-red/60 tracking-[0.4em] uppercase">Datos de misión</span>
        </div>

        <!-- Data rows -->
        <div class="divide-y divide-white/5">
          {data.map((item) => (
            <div class="px-6 py-4 flex flex-col gap-1">
              <span class="font-orbit text-[7px] text-muted/30 tracking-[0.3em] uppercase">{item.label}</span>
              <span class="font-body text-sm text-offwhite/85">{item.value}</span>
            </div>
          ))}
        </div>

        <!-- Status indicator -->
        <div class="px-6 py-5 border-t border-white/5 flex items-center gap-3">
          <span class="relative flex h-1.5 w-1.5 shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cin-red opacity-60"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-cin-red"></span>
          </span>
          <span class="font-orbit text-[7px] text-cin-red/70 tracking-[0.35em] uppercase">Sistema activo</span>
        </div>
      </div>
    </div>
  </div>
</section>
