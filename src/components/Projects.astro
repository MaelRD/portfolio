---
const projects = [
  {
    number: '01',
    title: 'LayoutBuilder',
    description: 'Web encargada de realizar y facilitar la carga de proveedores, clientes y productos mediante una API conectada a Odoo.',
    tags: ['Astro', 'Java', 'Postgres'],
    link: 'http://35.202.245.49/login/',
    repo: 'https://github.com/MaelRD/CargasBuilder/tree/main',
    featured: true,
  },
  {
    number: '02',
    title: 'Cosmos',
    description: "Sistema de gestión de soporte técnico con autenticación JWT y KPIs automatizados con Python.",
    tags: ['Java', 'Astro', 'TypeScript', 'Python', 'Postgres'],
    link: '#',
    repo: 'https://github.com/MaelRD/Cosmos',
    featured: true,
  },
  {
    number: '03',
    title: 'Sistema de gestión',
    description: 'Breve descripción de este trabajo. Añade métricas de impacto como usuarios o conversiones.',
    tags: ['TypeScript', 'Python'],
    link: '#',
    repo: '#',
    featured: false,
  },
  {
    number: '04',
    title: 'Proyecto Cuatro',
    description: 'Proyecto que muestra amplitud de experiencia o profundidad técnica.',
    tags: ['Python', 'FastAPI', 'Docker'],
    link: '#',
    repo: '#',
    featured: false,
  },
];
---

<section id="proyectos" class="py-24 lg:py-32">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Section header -->
    <div class="flex items-end justify-between mb-16 reveal">
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-8 h-px bg-cin-red"></div>
          <span class="font-body text-cin-red text-[10px] font-medium tracking-[0.25em] uppercase">Trabajo</span>
        </div>
        <h2 class="font-headline font-bold text-4xl md:text-5xl tracking-normal text-offwhite">
          Proyectos<br /><span class="text-muted">Destacados</span>
        </h2>
      </div>
      <a href="#" class="hidden md:flex items-center gap-2 font-body text-xs text-muted hover:text-cin-red transition-colors duration-200 cursor-pointer">
        Ver todos
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <!-- Featured: crystal editorial rows -->
    <div class="space-y-4">
      {projects.filter(p => p.featured).map((project, i) => (
        <article class={`crystal crystal-sweep group relative p-8 md:p-10 hover:border-cin-red/20 transition-colors duration-300 cursor-pointer reveal stagger-${i + 1}`}>
          <div class="relative z-10 grid md:grid-cols-[72px_1fr_140px] gap-6 md:gap-8 items-start">

            <!-- Editorial number -->
            <span class="hidden md:block font-headline font-bold text-[4.5rem] leading-none text-cin-red/12 group-hover:text-cin-red/25 transition-colors duration-500 select-none tabular-nums">{project.number}</span>

            <!-- Content -->
            <div class="space-y-3">
              <h3 class="font-headline font-bold text-xl md:text-2xl text-offwhite group-hover:text-cin-red transition-colors duration-200">{project.title}</h3>
              <p class="font-body text-muted text-sm leading-relaxed max-w-xl">{project.description}</p>
              <div class="flex flex-wrap gap-2 pt-1">
                {project.tags.filter(Boolean).map((tag) => (
                  <span class="font-body text-[11px] font-medium text-cin-red/65 bg-cin-red/8 px-2.5 py-1 border border-cin-red/10">{tag}</span>
                ))}
              </div>
            </div>

            <!-- Links -->
            <div class="flex md:flex-col items-start gap-3 md:items-end pt-0 md:pt-1">
              <a href={project.link} class="font-body text-xs font-medium text-muted hover:text-offwhite transition-colors duration-200 cursor-pointer" aria-label={`Ver demo de ${project.title}`}>Demo →</a>
              <a href={project.repo} class="font-body text-xs font-medium text-muted hover:text-offwhite transition-colors duration-200 cursor-pointer" aria-label={`Ver código de ${project.title}`}>Código →</a>
              <svg class="w-4 h-4 text-cin-red opacity-0 group-hover:opacity-100 transition-opacity duration-200 hidden md:block mt-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Non-featured: compact list -->
    <div class="mt-10 reveal stagger-3">
      <p class="font-body text-[10px] text-muted/35 tracking-[0.25em] uppercase mb-3">Más proyectos</p>
      {projects.filter(p => !p.featured).map((project, i) => (
        <div class={`group flex items-center gap-5 py-4 border-b border-surface/40 hover:bg-surface/10 transition-colors duration-200 cursor-pointer px-1 reveal stagger-${i + 4}`}>
          <span class="font-body text-[10px] font-mono text-cin-red/30 w-6 shrink-0">{project.number}</span>
          <h3 class="font-headline font-bold text-sm text-offwhite group-hover:text-cin-red transition-colors duration-200 flex-1">{project.title}</h3>
          <div class="hidden md:flex flex-wrap gap-1.5">
            {project.tags.filter(Boolean).map((tag) => (
              <span class="font-body text-[10px] text-muted/45 bg-surface px-2 py-0.5">{tag}</span>
            ))}
          </div>
          <svg class="w-3 h-3 text-cin-red/35 opacity-0 group-hover:opacity-100 transition-opacity shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </div>
      ))}
    </div>

  </div>
</section>
