---
const projects = [
  {
    number: '01',
    title: 'LayoutBuilder',
    description: 'Es una web encargada de realizar y facilitar la carga de provedores, clientes y productos por medio de una Api a Odoo.',
    tags: ['Astro', 'Java', 'Postgres'],
    link: '#',
    repo: '#',
    featured: true,
  },
  {
    number: '02',
    title: 'Cosmos',
    description: "Proyecto de gestion de soporte tecnico, con jwt y kpi's automatizados con python.",
    tags: ['Java', 'Astro', 'TypeScript', 'Python', 'Postgres'],
    link: '#',
    repo: '#',
    featured: true,
  },
  {
    number: '03',
    title: 'Sistema de gestión',
    description: 'Breve descripción de este trabajo. Puedes añadir métricas de impacto como usuarios o conversiones.',
    tags: ['TypeScript', 'Python', ''],
    link: '#',
    repo: '#',
    featured: false,
  },
  {
    number: '04',
    title: 'Proyecto Cuatro',
    description: 'Otro proyecto destacado que muestre la amplitud de tu experiencia o profundidad técnica.',
    tags: ['Python', 'FastAPI', 'Docker'],
    link: '#',
    repo: '#',
    featured: false,
  },
];
---

<section id="proyectos" class="py-24 lg:py-32">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Section header -->
    <div class="flex items-end justify-between mb-16">
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-8 h-px bg-cin-red"></div>
          <span class="text-cin-red text-xs font-medium tracking-[0.2em] uppercase">Trabajo</span>
        </div>
        <h2 class="font-headline font-bold text-4xl md:text-5xl tracking-tighter text-offwhite">
          Proyectos<br /><span class="text-muted">Destacados</span>
        </h2>
      </div>
      <a href="#" class="hidden md:flex items-center gap-2 text-sm text-muted hover:text-cin-red transition-colors duration-300">
        Ver todos
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <!-- Projects grid -->
    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <article class="group relative bg-surface rounded-lg p-8 hover:bg-surface/80 transition-all duration-300 ease-smooth border border-transparent hover:border-cin-red/20 cursor-pointer">
          <!-- Number -->
          <span class="text-xs font-mono text-cin-red/60 mb-4 block">{project.number}</span>

          <!-- Title -->
          <h3 class="font-headline font-bold text-xl text-offwhite mb-3 group-hover:text-cin-red transition-colors duration-300">
            {project.title}
          </h3>

          <!-- Description -->
          <p class="text-muted text-sm leading-relaxed mb-6">
            {project.description}
          </p>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mb-6">
            {project.tags.map((tag) => (
              <span class="px-2.5 py-1 text-xs font-medium text-muted bg-obsidian rounded border border-surface">
                {tag}
              </span>
            ))}
          </div>

          <!-- Links -->
          <div class="flex items-center gap-4">
            <a
              href={project.link}
              class="flex items-center gap-1.5 text-xs font-medium text-offwhite hover:text-cin-red transition-colors duration-300"
              aria-label={`Ver demo de ${project.title}`}
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              Demo
            </a>
            <a
              href={project.repo}
              class="flex items-center gap-1.5 text-xs font-medium text-muted hover:text-offwhite transition-colors duration-300"
              aria-label={`Ver código de ${project.title}`}
            >
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              Código
            </a>
          </div>

          <!-- Hover arrow -->
          <div class="absolute top-8 right-8 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <svg class="w-4 h-4 text-cin-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
