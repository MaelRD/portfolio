---
// Fine decorative texture from the source design that Stars.astro doesn't
// provide: a faint scale grid, a film-grain noise overlay and a soft violet
// glow behind the hero. Purely presentational, no interactivity — the
// starfield/nebula itself is already handled by Stars.astro.
---

<div class="cosmic-backdrop" aria-hidden="true">
  <div class="cosmic-grid"></div>
  <div class="cosmic-noise"></div>
  <div class="cosmic-glow"></div>
</div>

<style>
  .cosmic-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .cosmic-grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(148, 163, 184, 0.055) 1px, transparent 1px) 0 0/96px 96px,
      linear-gradient(0deg, rgba(148, 163, 184, 0.055) 1px, transparent 1px) 0 0/96px 96px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, #000 20%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, #000 20%, transparent 85%);
  }

  .cosmic-noise {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    mix-blend-mode: overlay;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="160" height="160"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3"/></filter><rect width="160" height="160" filter="url(%23n)" opacity="0.5"/></svg>');
  }

  .cosmic-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 45% at 50% 0%, rgba(139, 92, 246, 0.16), transparent 70%);
  }
</style>
