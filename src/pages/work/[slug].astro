---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CaseStudyApp from "../../components/CaseStudyApp";
import { PERSON } from "../../lib/seo";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).map((e) => e.data).sort((a, b) => a.order - b.order);
  const withCase = projects.filter((p) => p.caseStudy);
  return withCase.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: withCase[(i + 1) % withCase.length] },
  }));
}

const { project, next } = Astro.props;
const title = `${project.title} — Case study | Mario Yael`;
const description = `${project.subtitle.en} ${project.summary.en}`;
const url = new URL(Astro.url.pathname, Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: `${project.title}: ${project.subtitle.en}`,
  description,
  url,
  inLanguage: ["en", "es"],
  author: PERSON,
  about: project.stack,
};
---

<Layout title={title} description={description} ogType="article" structuredData={structuredData}>
  <CaseStudyApp client:load project={project} next={next.slug === project.slug ? undefined : next} />
</Layout>
